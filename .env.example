AWS_REGION=us-east-1
S3_BUCKET_NAME=
SNS_TOPIC_ARN=
DB_PATH=photos.db
USE_SQS=false
SQS_QUEUE_URL=
HOLD_DAYS=60
HOLD_DEMO_MINUTES=
SITE_URL=
# 서버는 무작위 값 (deploy/setup_web.sh가 생성). 로컬 개발은 비워도 됨
FLASK_SECRET_KEY=
# A: 시연 모드. 값(예: 3)이 있으면 keep/ 사진이 그 분 뒤 Glacier IR로 전환 (A 서버만, 평소엔 비워 둠)
KEEP_DEMO_MINUTES=

# B: true로 직접 켰을 때만 S3 대신 tmp/_local_store에 저장 (버킷 없이 화면 테스트용, 서버에서는 쓰지 말 것)
USE_LOCAL_STORAGE=false
